@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix kwgr: <http://stko-kwg.geog.ucsb.edu/lod/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s2: <http://purl.org/spatialai/spatial/s2cells#> .
@prefix stad: <http://purl.org/spatialai/stad/v2/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.org/spatialai/spatial/s2cells> rdf:type owl:Ontology ;
                                            dcterms:issued "2025-02-19"^^xsd:date ;
											dcterms:modified "2025-02-19"^^xsd:date ;
											prov:wasDerivedFrom s2:sourceDataset ;
											owl:versionInfo "0.1"^^xsd:string .

s2:sourceDataset rdf:type stad:Dataset ;
                 rdfs:label "S2 Geometry" ;
				 dcterms:issued "2024-12-27"^^xsd:date ;
				 dcterms:source <https://github.com/KnowWhereGraph/s2-coverings> ;
				 rdfs:comment "This dataset points to KWG's s2-coverings repo, the tool KWG used to create their S2 cells" ;
				 rdfs:comment "SAWGraph queried Level 13 S2 cells from KnowWhereGraph" ;
				 rdfs:seeAlso <https://s2geometry.io/> ;
				 stad:hasSpatialCoverage kwgr:administrativeRegion.USA .
