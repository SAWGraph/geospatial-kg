# Sample one AR3 per state
# Gives a sense of the types of AR3 in each state
#    township, town, et al.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX kwg-ont: <http://stko-kwg.geog.ucsb.edu/lod/ontology/>

SELECT (SAMPLE(?s_name) as ?name)
WHERE {
    ?s rdf:type kwg-ont:AdministrativeRegion_3 ;
       rdfs:label ?s_name ;
       kwg-ont:administrativePartOf/kwg-ont:administrativePartOf ?o .
    ?o rdf:type kwg-ont:AdministrativeRegion_1 .
    FILTER CONTAINS(str(?o), "kwg")
} GROUP BY ?o
