# Retrieve all administrative regions within South Dakota
# The second filter avoids duplicates

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX kwg-ont: <http://stko-kwg.geog.ucsb.edu/lod/ontology/>

SELECT DISTINCT ?s_name
WHERE {
    ?s rdf:type kwg-ont:AdministrativeRegion_3 ;
       rdfs:label ?s_name ;
       kwg-ont:administrativePartOf/kwg-ont:administrativePartOf ?o .
    ?o rdf:type kwg-ont:AdministrativeRegion_1 ;
       rdfs:label ?o_name .
    FILTER CONTAINS(str(?o_name), "South Dakota")
    FILTER CONTAINS(str(?o), "kwg")
} ORDER BY ?s_name
